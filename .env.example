SITE_URL=http://localhost:4321
DATABASE_URL=postgres://lumiere:lumiere@localhost:5432/lumiere

# Production only (docker-compose.yml): database password and Docker Hub mirror for Iranian servers
POSTGRES_PASSWORD=
REGISTRY=

# Payment: "mock" in development, "zarinpal" in production
PAYMENT_PROVIDER=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# SMS: "console" in development, "kavenegar" in production
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=lumiere-otp
KAVENEGAR_SENDER=

# Phone numbers (comma separated) that become admins on first login
ADMIN_PHONES=09120000000

# Where uploaded product images are written (served at /media)
MEDIA_DIR=./media
