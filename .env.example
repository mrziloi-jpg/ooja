# One .env per environment: /opt/lumiere/.env (production) and /opt/lumiere-staging/.env (staging).
# Never share values between them (each has its own POSTGRES_PASSWORD). Never commit a .env.
# For local development the values below work as they are.

# Public URL. On the server: https://oojashop.ir (production) or https://staging.oojashop.ir (staging).
# Baked into the image at build time: deploy/release.sh rebuilds with it.
SITE_URL=http://localhost:4321
DATABASE_URL=postgres://lumiere:lumiere@localhost:5432/lumiere

# Server only (docker-compose.yml): database password and Docker Hub mirror for Iranian servers
# (REGISTRY=docker.arvancloud.ir/ , trailing slash matters). Generate the password per environment:
#   openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=
REGISTRY=

# Payment: "mock" in development, "zarinpal" in production (staging is forced to mock by deploy/compose.staging.yml)
PAYMENT_PROVIDER=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# SMS: "console" in development, "kavenegar" in production (staging is forced to console by deploy/compose.staging.yml)
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=lumiere-otp
KAVENEGAR_SENDER=

# Phone numbers (comma separated) that become admins on first login.
# On staging these users also keep their own data when deploy/refresh-staging.sh anonymizes the copy.
ADMIN_PHONES=09120000000

# Where uploaded product images are written (served at /media). Overridden to /media in Docker.
MEDIA_DIR=./media

# --- Server scripts (optional) ---
# Off-server backup destination for deploy/backup.sh (an rclone remote), e.g. myremote:lumiere-backups/prod
# BACKUP_RCLONE_REMOTE=

# --- Staging only (optional): memory overrides for deploy/compose.staging.yml ---
# STAGING_APP_MEM=384m
# STAGING_NODE_HEAP_MB=256
# STAGING_DB_MEM=512m
# STAGING_PG_SHARED_BUFFERS=128MB
# STAGING_PG_CACHE_SIZE=384MB
# STAGING_NGINX_MEM=64m
