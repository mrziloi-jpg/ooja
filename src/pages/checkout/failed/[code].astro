---
import Layout from '~/layouts/Layout.astro';
const code = Astro.params.code;
---
<Layout title="پرداخت ناموفق" noindex>
  <div class="wrap" style="padding-top:72px;padding-bottom:96px;max-width:640px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:18px">
    <h1 style="margin:0;font-size:clamp(28px,3.4vw,40px);font-weight:800">پرداخت انجام نشد.</h1>
    <p style="margin:0;font-size:16px;line-height:2;color:#3A3A3A">
      سفارش <span class="en">{code}</span> لغو شد و مبلغی از حساب شما کسر نشده است. اگر مبلغی کسر شده باشد، طی ۷۲ ساعت توسط بانک بازگردانده می‌شود.
    </p>
    <div style="display:flex;flex-wrap:wrap;gap:10px;justify-content:center">
      <a class="btn btn-dark" href="/checkout">تلاش دوباره</a>
      <a class="btn btn-line" href="/help#contact">تماس با پشتیبانی</a>
    </div>
  </div>
</Layout>
