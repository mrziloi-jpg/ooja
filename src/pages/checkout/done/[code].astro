---
import Layout from '~/layouts/Layout.astro';
import { eq } from 'drizzle-orm';
import { db, schema as s } from '~/db';
import { money } from '~/lib/format';
import { getStore } from '~/lib/settings';
import { STATUS_LABELS } from '~/lib/orders';

const [o] = await db.select().from(s.orders).where(eq(s.orders.code, Astro.params.code!)).limit(1);
// Only the owner, an admin, or the browser that just placed this order may see it.
const u = Astro.locals.user;
const allowed = o && (Astro.cookies.get('last_order')?.value === o.code || (u && (u.id === o.userId || u.phone === o.phone || u.role === 'admin')));
if (!o || !allowed) return Astro.redirect('/account/orders');
const ship = (await getStore()).shipping.find((x) => x.id === o.shipMethod);
---
<Layout title="سفارش ثبت شد" noindex>
  <div class="wrap" style="padding-top:72px;padding-bottom:96px;max-width:720px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:18px">
    <span aria-hidden="true" style="width:64px;height:64px;border-radius:50%;background:#111111;color:#FFFFFF;display:flex;align-items:center;justify-content:center">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
    </span>
    <h1 style="margin:0;font-size:clamp(28px,3.4vw,40px);font-weight:800">سفارش شما ثبت شد.</h1>
    <p style="margin:0;font-size:16px;line-height:2;color:#3A3A3A">
      شماره‌ی سفارش: <strong class="en">{o.code}</strong><br />
      وضعیت: {STATUS_LABELS[o.status]} · {ship?.name} ({ship?.eta})<br />
      مبلغ: {money(o.total)}{o.gatewayRef && o.gatewayRef !== 'CREDIT' && <> · کد پیگیری پرداخت: <span class="en">{o.gatewayRef}</span></>}
    </p>
    <p style="margin:0;font-size:14px;color:#5C5C5C">پیامک تأیید به <span class="en">{o.phone.slice(0, 4)}•••{o.phone.slice(-3)}</span> ارسال شد.</p>
    <div style="display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:16px">
      <a class="btn btn-dark" href="/account/orders">پیگیری سفارش در حساب کاربری</a>
      <a class="btn btn-line" href="/">بازگشت به فروشگاه</a>
    </div>
  </div>
</Layout>
