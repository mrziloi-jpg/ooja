---
// Development stand-in for the bank gateway. Disabled unless PAYMENT_PROVIDER=mock.
import Layout from '~/layouts/Layout.astro';
import { config } from '~/lib/config';
import { money } from '~/lib/format';

if (config.paymentProvider !== 'mock') return new Response(null, { status: 404 });
const authority = Astro.url.searchParams.get('authority') ?? '';
const amount = Number(Astro.url.searchParams.get('amount') ?? 0);
const back = (status: string) => `/checkout/callback?Authority=${encodeURIComponent(authority)}&Status=${status}`;
---
<Layout title="درگاه آزمایشی" noindex bare>
  <div style="max-width:440px;margin:80px auto;padding:32px;border:1px solid #111111;display:flex;flex-direction:column;gap:16px;text-align:center">
    <p class="kicker">درگاه پرداخت آزمایشی (فقط محیط توسعه)</p>
    <p style="margin:0;font-size:28px;font-weight:800">{money(amount)}</p>
    <a class="btn btn-dark" href={back('OK')}>پرداخت موفق</a>
    <a class="btn btn-line" href={back('NOK')}>انصراف از پرداخت</a>
  </div>
</Layout>
