---
import Layout from '~/layouts/Layout.astro';
import ProductArt from '~/components/ProductArt.astro';
import { getCatalog } from '~/lib/catalog';
import { getSettings } from '~/lib/settings';
import { fa } from '~/lib/format';
import { config } from '~/lib/config';

const [cat, st] = await Promise.all([getCatalog(), getSettings()]);
const STEPS = [
  { title: 'پژوهش', text: 'هر فرمول با مرور مطالعات منتشرشده درباره‌ی یک ترکیب فعال شروع می‌شود: چه غلظتی اثر دارد، روی چه نوع پوستی و با چه ترکیباتی تداخل دارد.' },
  { title: 'فرمولاسیون', text: 'فرمول را تا حد ممکن ساده نگه می‌داریم؛ ترکیب فعال در غلظت مؤثر، به‌همراه موادی که پایداری و احساس روی پوست را بهتر می‌کنند. بدون عطر و رنگ افزوده.' },
  { title: 'آزمایش', text: 'تست پایداری، تست تحریک پوستی زیر نظر متخصص پوست و در صورت امکان، مطالعه‌ی بالینی مستقل روی داوطلبان با انواع پوست.' },
  { title: 'شفافیت', text: 'نام محصول همان ترکیب و درصد اصلی آن است. فهرست کامل ترکیبات، نحوه‌ی مصرف و سازگاری با محصولات دیگر را منتشر می‌کنیم تا انتخاب آگاهانه داشته باشید.' },
];
// Stats use real numbers; the founding year shows only once it's set in Admin › Settings.
const stats = [
  { v: fa(cat.products.length), l: 'فرمول در مجموعه' },
  { v: '۱۰۰٪', l: 'درصد ترکیبات کلیدی روی برچسب' },
  { v: '۰', l: 'عطر افزوده و آزمایش حیوانی' },
  ...(st.foundedYear ? [{ v: fa(st.foundedYear), l: 'سال تأسیس' }] : []),
];
const site = config.siteUrl.replace(/\/$/, '');
const sameAs = [st.instagram, st.telegramChannel].filter(Boolean);
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'AboutPage', url: `${site}/about`, inLanguage: 'fa-IR',
  mainEntity: { '@type': 'Organization', name: 'LUMIÈRE', url: site, ...(st.foundedYear ? { foundingDate: st.foundedYear } : {}), ...(sameAs.length ? { sameAs } : {}) },
};
---
<Layout title="درباره‌ی ما — مراقبت پوست قابل فهم" description="LUMIÈRE با یک ایده شروع شد: اسم هر محصول باید بگوید داخلش چیست. فرمول‌های بالینی، بدون عطر و وگان، با درصد دقیق ترکیبات روی برچسب." active="about" jsonLd={jsonLd} cache={300}>
  <section class="wrap" style="padding-top:72px;padding-bottom:72px;display:flex;flex-wrap:wrap;gap:48px;align-items:center">
    <div style="flex:1 1 520px;display:flex;flex-direction:column;gap:20px">
      <p class="kicker" style="font-size:13px">درباره‌ی ما</p>
      <h1 style="margin:0;font-size:clamp(38px,5vw,68px);font-weight:800;line-height:1.2;letter-spacing:-.02em">مراقبت پوست باید<br />قابل فهم باشد.</h1>
      <p style="margin:0;max-width:560px;font-size:17px;line-height:2.1;color:#3A3A3A">LUMIÈRE با یک ایده شروع شد: اسم هر محصول باید بگوید داخلش چیست. بدون وعده‌های اغراق‌آمیز، بدون «فرمول محرمانه» و با قیمتی که هزینه‌ی تبلیغات در آن نیست.</p>
    </div>
    <div aria-hidden="true" style="flex:1 1 420px;min-height:460px;position:relative;display:flex;align-items:center;justify-content:center;background:radial-gradient(ellipse at 50% 45%,#FFFFFF 0%,#F4F4F2 60%,#EBEBE8 100%)">
      <div style="position:absolute;left:50%;bottom:16%;width:260px;height:24px;transform:translateX(-50%);border-radius:50%;background:radial-gradient(ellipse,rgba(0,0,0,.2) 0%,rgba(0,0,0,0) 70%)"></div>
      <div style="position:absolute;left:50%;bottom:18%;transform:translateX(-50%)"><ProductArt shape="dropper" glass="#E9ECEB" nameEn="What's inside, on the label." scale={1.9} /></div>
    </div>
  </section>

  <section style="background:#111111;color:#FFFFFF">
    <div class="wrap stats" style="padding-top:64px;padding-bottom:64px">
      {stats.map((x) => <div><span style="font-size:44px;font-weight:300">{x.v}</span><span style="font-size:14px;color:#CFCFCF">{x.l}</span></div>)}
    </div>
  </section>

  <section class="wrap" style="padding-top:88px;padding-bottom:88px">
    <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:32px">
      <h2 class="h2">یک فرمول چطور به دست شما می‌رسد؟</h2>
      <div role="tablist" aria-label="مراحل" style="display:flex;flex-wrap:wrap">
        {STEPS.map((x, i) => <button type="button" class="tabbtn" role="tab" id={`st-${i}`} aria-controls={`sp-${i}`} aria-selected={i === 0} data-step={i}>{fa(i + 1)}. {x.title}</button>)}
      </div>
    </div>
    {STEPS.map((x, i) => (
      <div role="tabpanel" id={`sp-${i}`} aria-labelledby={`st-${i}`} hidden={i !== 0} style="flex-wrap:wrap;gap:40px;align-items:flex-start;border-top:1px solid #111111;padding-top:32px">
        <span aria-hidden="true" style="flex:0 0 auto;font-size:120px;font-weight:200;line-height:.9">{fa(`0${i + 1}`)}</span>
        <div style="flex:1 1 420px;display:flex;flex-direction:column;gap:14px">
          <h3 style="margin:0;font-size:26px;font-weight:800">{x.title}</h3>
          <p style="margin:0;max-width:680px;font-size:16px;line-height:2.1;color:#3A3A3A">{x.text}</p>
        </div>
      </div>
    ))}
  </section>

  <section style="background:#F4F4F2">
    <div class="wrap" style="padding-top:80px;padding-bottom:80px;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px">
      <div style="grid-column:1 / -1;margin-bottom:8px"><h2 class="h2">تعهدات ما</h2></div>
      <div class="commit"><h3>شفافیت کامل</h3><p>فهرست کامل ترکیبات، درصد مواد کلیدی و نحوه‌ی مصرف هر محصول منتشر می‌شود.</p><a href="/ingredients">واژه‌نامه‌ی ترکیبات</a></div>
      <div class="commit" id="cruelty-free"><h3>ایمنی، بدون آزمایش حیوانی</h3><p>تولید زیر نظارت و ثبت محصولات در سازمان غذا و دارو؛ کد ثبت (IRC) هر محصول در صفحه‌ی خود آن درج شده است. بدون عطر افزوده و بدون آزمایش روی حیوانات.</p><a href="/shop">مشاهده‌ی محصولات</a></div>
      <div class="commit" id="sustainability"><h3>بسته‌بندی آگاهانه</h3><p>شیشه و آلومینیوم قابل بازیافت، ری‌فیل برای پرفروش‌ها و ارسال بدون پلاستیک. بطری‌های خالی را با سفارش بعدی پس بفرستید.</p></div>
      <div class="commit"><h3>قیمت منصفانه</h3><p>بودجه را صرف فرمول و تحقیق می‌کنیم، نه بسته‌بندی لوکس و تبلیغات. نتیجه: قیمتی که بتوانید روتین کامل داشته باشید.</p></div>
    </div>
  </section>

  {st.supportEmail && (
    <section id="careers" class="wrap" style="padding-top:64px;padding-bottom:16px">
      <div style="border:1px solid #111111;padding:28px;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:16px">
        <div style="display:flex;flex-direction:column;gap:6px">
          <h2 style="margin:0;font-size:20px;font-weight:800">فرصت‌های شغلی</h2>
          <p style="margin:0;font-size:14px;color:#3A3A3A">اگر به مراقبت پوست علمی و صادقانه علاقه دارید، رزومه‌ی خود را برای ما بفرستید.</p>
        </div>
        <a class="btn btn-line" href={`mailto:${st.supportEmail}?subject=${encodeURIComponent('رزومه')}`}>ارسال رزومه</a>
      </div>
    </section>
  )}

  <section class="wrap" style="padding-top:80px;padding-bottom:96px;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:24px">
    <div style="display:flex;flex-direction:column;gap:10px;max-width:640px">
      <h2 class="h2">از کجا شروع کنم؟</h2>
      <p style="margin:0;font-size:16px;line-height:2;color:#3A3A3A">تست ۶۰ ثانیه‌ای پوست، روتین شما را پیشنهاد می‌دهد. یا با کارشناس ما ۱۵ دقیقه صحبت کنید.</p>
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:10px">
      <a class="btn btn-dark" href="/quiz">شروع تست پوست</a>
      <a class="btn btn-line" href="/consultation">رزرو مشاوره</a>
    </div>
  </section>
</Layout>

<style>
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .stats > div { padding: 20px 24px; display: flex; flex-direction: column; gap: 6px; }
  .stats > div + div { border-inline-start: 1px solid #333333; }
  .tabbtn { min-height: 44px; padding: 0 18px; border: 1px solid #111111; background: #FFFFFF; font-size: 14px; color: #111111; }
  .tabbtn[aria-selected=true] { background: #111111; color: #FFFFFF; }
  [role=tabpanel]:not([hidden]) { display: flex; }
  .commit { background: #FFFFFF; padding: 28px; display: flex; flex-direction: column; gap: 10px; scroll-margin-top: 90px; }
  .commit h3 { margin: 0; font-size: 19px; font-weight: 800; }
  .commit p { margin: 0; font-size: 14px; line-height: 2; color: #3A3A3A; }
  .commit a { font-size: 14px; font-weight: 600; text-decoration: underline; margin-top: auto; }
</style>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-step]')];
  const select = (i: number) => tabs.forEach((t, k) => {
    t.setAttribute('aria-selected', String(k === i));
    t.tabIndex = k === i ? 0 : -1;
    document.getElementById(`sp-${k}`)!.hidden = k !== i;
  });
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(i));
    // Arrow keys move between tabs (RTL: left = next).
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowLeft' ? 1 : e.key === 'ArrowRight' ? -1 : 0;
      if (!d) return;
      const n = (i + d + tabs.length) % tabs.length;
      select(n);
      tabs[n].focus();
    });
  });
  select(0);
</script>
