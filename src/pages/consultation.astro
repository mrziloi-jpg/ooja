---
import Layout from '~/layouts/Layout.astro';
import Booking from '~/islands/Booking';
import { and, gte, lt, ne } from 'drizzle-orm';
import { db, schema as s } from '~/db';
import { bookableDays, slotDate } from '~/lib/consult';
import { jalaliDate } from '~/lib/format';
import { config } from '~/lib/config';

// Not cached: availability must be current. The query is one indexed range scan.
const raw = bookableDays();
const days = raw.map((d) => {
  const noon = slotDate(d.day, '12:00');
  return { ...d, week: jalaliDate(noon, { weekday: 'long' }), date: jalaliDate(noon, { day: 'numeric', month: 'short' }), label: jalaliDate(noon, { weekday: 'long', day: 'numeric', month: 'long' }) };
});
const from = slotDate(raw[0].day, '00:00');
const to = new Date(slotDate(raw[raw.length - 1].day, '23:59').getTime() + 60_000);
const taken = (await db.select({ at: s.consultations.startsAt }).from(s.consultations)
  .where(and(gte(s.consultations.startsAt, from), lt(s.consultations.startsAt, to), ne(s.consultations.status, 'canceled'))))
  .map((r) => r.at.getTime());
const u = Astro.locals.user;
const site = config.siteUrl.replace(/\/$/, '');
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Service', name: 'مشاوره‌ی آنلاین رایگان پوست', serviceType: 'مشاوره‌ی مراقبت پوست',
  provider: { '@type': 'Organization', name: 'OOJA SHOP', url: site }, areaServed: 'IR', url: `${site}/consultation`,
  offers: { '@type': 'Offer', price: 0, priceCurrency: 'IRR' },
};
---
<Layout title="مشاوره‌ی آنلاین رایگان پوست — رزرو وقت" description="۱۵ دقیقه مشاوره‌ی رایگان با کارشناس پوست از طریق تماس تصویری، صوتی یا چت. روتین شما را بررسی می‌کنیم و ترکیبات مناسب را پیشنهاد می‌دهیم." active="consultation" jsonLd={jsonLd}>
  <section style="background:#111111;color:#FFFFFF">
    <div class="wrap" style="padding-top:64px;padding-bottom:56px;display:flex;flex-wrap:wrap;gap:32px;justify-content:space-between;align-items:flex-end">
      <div style="flex:1 1 520px;display:flex;flex-direction:column;gap:14px">
        <p style="margin:0;font-size:13px;font-weight:600;color:#BDBDBD">مشاوره‌ی آنلاین · رایگان</p>
        <h1 style="margin:0;font-size:clamp(34px,4.4vw,56px);font-weight:800;line-height:1.25">۱۵ دقیقه با کارشناس پوست.</h1>
        <p style="margin:0;max-width:560px;font-size:16px;line-height:2;color:#D9D9D9">روتین فعلی‌تان را بررسی می‌کنیم، به سؤال‌هایتان جواب می‌دهیم و ترکیب‌های مناسب را پیشنهاد می‌کنیم. بدون الزام به خرید.</p>
      </div>
      <ul style="flex:0 1 360px;list-style:none;margin:0;padding:0;font-size:14px;color:#D9D9D9">
        <li style="padding:10px 0;border-top:1px solid #333333">کارشناسان آموزش‌دیده در فرمولاسیون و مراقبت پوست</li>
        <li style="padding:10px 0;border-top:1px solid #333333">شنبه تا پنجشنبه، ۱۰ صبح تا ۸ شب</li>
        <li style="padding:10px 0;border-top:1px solid #333333;border-bottom:1px solid #333333">تأیید و یادآوری پیامک می‌شود</li>
      </ul>
    </div>
  </section>
  <Booking client:load days={days} taken={taken} user={u ? { name: [u.firstName, u.lastName].filter(Boolean).join(' '), phone: u.phone } : null} />
</Layout>

<style is:global>
  .h3 { margin: 0; font-size: 20px; font-weight: 800; display: flex; align-items: center; gap: 12px; }
  .num { width: 30px; height: 30px; background: #111111; color: #FFFFFF; display: inline-flex; align-items: center; justify-content: center; font-size: 14px; }
  .ctype { border: 1px solid #D6D6D4; background: #FFFFFF; padding: 20px; text-align: right; display: flex; flex-direction: column; gap: 8px; color: #111111; min-height: 150px; }
  .ctype:hover { border-color: #111111; }
  .ctype[aria-checked=true] { border-color: #111111; box-shadow: inset 0 0 0 1px #111111; }
  .cday { border: 1px solid #D6D6D4; background: #FFFFFF; min-width: 96px; padding: 12px 10px; display: flex; flex-direction: column; align-items: center; gap: 4px; color: #111111; flex: 0 0 auto; }
  .cday:hover { border-color: #111111; }
  .cday[aria-checked=true] { background: #111111; color: #FFFFFF; border-color: #111111; }
  .cday:disabled { opacity: .4; cursor: not-allowed; }
  .cslot { min-height: 46px; border: 1px solid #D6D6D4; background: #FFFFFF; font-size: 14px; font-weight: 600; color: #111111; }
  .cslot:hover { border-color: #111111; }
  .cslot[aria-checked=true] { background: #111111; color: #FFFFFF; border-color: #111111; }
  .cslot:disabled { color: #9A9A98; text-decoration: line-through; cursor: not-allowed; background: #F4F4F2; }
</style>
