---
import ShopView from '~/components/ShopView.astro';
import { getCatalog } from '~/lib/catalog';

const cat = await getCatalog();
const c = cat.categories.find((x) => x.slug === Astro.params.category);
if (!c) return new Response(null, { status: 404 });
---
<ShopView
  preset={{ cat: [c.slug] }}
  title={c.name}
  crumb={c.name}
  basePath={`/shop/${c.slug}`}
  seoTitle={`خرید ${c.name}`}
  seoDescription={`${c.name} LUMIÈRE با ترکیبات فعال و درصد دقیق روی برچسب. بدون عطر، وگان، ارسال به سراسر ایران.`}
/>
