---
import AccountLayout from '~/layouts/AccountLayout.astro';
import { and, asc, desc, eq, gt } from 'drizzle-orm';
import { db, schema as s } from '~/db';
import { CUSTOMER_STATUS, ownOrders, refillSuggestion, tierOf } from '~/lib/account';
import { fa, jalaliDate, money, SKIN_TYPES } from '~/lib/format';
import { GOALS } from '~/lib/routine';
import { bookingCode, KIND_LABEL } from '~/lib/consult';

const u = Astro.locals.user!;
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  if (f.get('action') === 'cancel_consult') {
    const [c] = await db.update(s.consultations).set({ status: 'canceled' })
      .where(and(eq(s.consultations.id, Number(f.get('id'))), eq(s.consultations.userId, u.id), eq(s.consultations.status, 'booked'), gt(s.consultations.startsAt, new Date())))
      .returning();
    return Astro.redirect(`/account?${c ? 'ok' : 'err'}=${encodeURIComponent(c ? 'وقت مشاوره لغو شد.' : 'این وقت قابل لغو نیست.')}`, 303);
  }
}
const [[latest], tier, refill, consults] = await Promise.all([
  db.select().from(s.orders).where(ownOrders(u)).orderBy(desc(s.orders.createdAt)).limit(1),
  tierOf(u),
  refillSuggestion(u),
  db.select().from(s.consultations)
    .where(and(eq(s.consultations.userId, u.id), eq(s.consultations.status, 'booked'), gt(s.consultations.startsAt, new Date())))
    .orderBy(asc(s.consultations.startsAt)),
]);
const goal = GOALS.find((g) => g.id === u.goal);
---
<AccountLayout title="حساب کاربری" section="overview">
  <h1 class="acc-h" style="font-size:clamp(26px,3vw,36px)">سلام {u.firstName ?? 'دوست عزیز'}، خوش آمدید.</h1>
  {!u.firstName && <p style="margin:0;font-size:14px">برای پیشنهادهای دقیق‌تر، <a href="/account/profile" style="text-decoration:underline">اطلاعات حساب</a> را کامل کنید.</p>}

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px">
    <div class="card" style="background:#111111;color:#FFFFFF;border-color:#111111">
      <p style="margin:0;font-size:12px;font-weight:600;color:#BDBDBD">امتیاز باشگاه</p>
      <p style="margin:0;font-size:36px;font-weight:300">{fa(u.points)}</p>
      <p style="margin:0;font-size:13px;color:#CFCFCF">سطح {tier.tier}{tier.next ? ` · ${money(tier.toNext)} خرید دیگر تا سطح ${tier.next}` : ''}</p>
      {u.credit > 0 && <p style="margin:0;font-size:13px;color:#CFCFCF">اعتبار خرید: {money(u.credit)}</p>}
      <a class="lnk" href="/account/points" style="color:#FFFFFF;align-self:flex-start">مشاهده‌ی جزئیات</a>
    </div>
    <div class="card">
      <p style="margin:0;font-size:12px;font-weight:600;color:#5C5C5C">آخرین سفارش</p>
      {latest ? (
        <>
          <div style="display:flex;justify-content:space-between;align-items:center;gap:10px"><span class="en" style="font-weight:700">{latest.code}</span><span class={`status ${CUSTOMER_STATUS[latest.status].cls}`}>{CUSTOMER_STATUS[latest.status].label}</span></div>
          <p style="margin:0;font-size:13px;color:#3A3A3A">{jalaliDate(latest.createdAt)} · {money(latest.total)}</p>
          <a class="lnk" href={`/account/orders/${latest.code}`} style="align-self:flex-start">پیگیری سفارش</a>
        </>
      ) : (
        <>
          <p style="margin:0;font-size:14px;color:#3A3A3A">هنوز سفارشی ثبت نکرده‌اید.</p>
          <a class="lnk" href="/shop" style="align-self:flex-start">شروع خرید</a>
        </>
      )}
    </div>
    <div class="card">
      <p style="margin:0;font-size:12px;font-weight:600;color:#5C5C5C">روتین من</p>
      {u.skinType && goal ? (
        <>
          <p style="margin:0;font-size:15px;font-weight:700">پوست {SKIN_TYPES[u.skinType]} · {goal.label}</p>
          <p style="margin:0;font-size:13px;color:#3A3A3A">روتین صبح و شب</p>
          <a class="lnk" href="/account/routine" style="align-self:flex-start">مشاهده‌ی روتین</a>
        </>
      ) : (
        <>
          <p style="margin:0;font-size:14px;color:#3A3A3A">با تست ۶۰ ثانیه‌ای، روتین مناسب پوستتان را بسازید.</p>
          <a class="lnk" href="/account/routine" style="align-self:flex-start">ساخت روتین</a>
        </>
      )}
    </div>
  </div>

  {consults.length > 0 && (
    <div class="card">
      <p style="margin:0;font-size:15px;font-weight:700">مشاوره‌های پیش رو</p>
      {consults.map((c) => (
        <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px;padding-top:10px;border-top:1px solid #EFEFED">
          <span style="display:flex;flex-direction:column;gap:2px">
            <span style="font-size:14px;font-weight:700">{KIND_LABEL[c.kind] ?? c.kind} · {jalaliDate(c.startsAt, { weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' })}</span>
            <span style="font-size:12px;color:#5C5C5C">کد <span class="en">{bookingCode(c.id)}</span>{c.topic && ` · ${c.topic}`}{c.meetingLink && <> · <a href={c.meetingLink} target="_blank" rel="noopener" style="text-decoration:underline">لینک جلسه</a></>}</span>
          </span>
          <form method="post"><input type="hidden" name="action" value="cancel_consult" /><input type="hidden" name="id" value={c.id} /><button class="lnk">لغو وقت</button></form>
        </div>
      ))}
    </div>
  )}

  {refill && (
    <div class="card" style="flex-direction:row;flex-wrap:wrap;justify-content:space-between;align-items:center;background:#F4F4F2;border-color:#F4F4F2" data-product>
      <div style="display:flex;flex-direction:column;gap:4px">
        <p style="margin:0;font-size:15px;font-weight:700">{refill.nameFa} شما احتمالاً رو به اتمام است.</p>
        <p style="margin:0;font-size:13px;color:#3A3A3A">بر اساس تاریخ خرید ({jalaliDate(refill.createdAt)}). همین حالا دوباره سفارش دهید.</p>
      </div>
      <button type="button" class="btn btn-dark" data-add={refill.variantId} data-name={refill.nameFa}>سفارش دوباره — {money(refill.price)}</button>
    </div>
  )}
</AccountLayout>
