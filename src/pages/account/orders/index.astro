---
import AccountLayout from '~/layouts/AccountLayout.astro';
import { CUSTOMER_STATUS, listOrders } from '~/lib/account';
import { fa, jalaliDate, money } from '~/lib/format';

const rows = await listOrders(Astro.locals.user!);
---
<AccountLayout title="سفارش‌های من" section="orders">
  <h1 class="acc-h">سفارش‌های من</h1>
  {rows.length === 0 ? (
    <div style="background:#F4F4F2;padding:40px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:12px">
      <p style="margin:0;font-weight:700">هنوز سفارشی ثبت نکرده‌اید.</p>
      <a class="btn btn-dark" href="/shop">مشاهده‌ی محصولات</a>
    </div>
  ) : (
    <div style="display:flex;flex-direction:column;border-top:1px solid #111111">
      {rows.map(({ o, items }) => (
        <div style="display:flex;flex-wrap:wrap;gap:16px;align-items:center;padding:20px 0;border-bottom:1px solid #E5E5E3">
          <div style="flex:1 1 200px;display:flex;flex-direction:column;gap:4px">
            <span class="en r" style="font-weight:700">{o.code}</span>
            <span style="font-size:13px;color:#5C5C5C">{jalaliDate(o.createdAt)} · {fa(items)} کالا</span>
          </div>
          <span class={`status ${CUSTOMER_STATUS[o.status].cls}`}>{CUSTOMER_STATUS[o.status].label}</span>
          <span style="min-width:130px;font-weight:700">{money(o.total)}</span>
          <a class="btn btn-line" href={`/account/orders/${o.code}`}>جزئیات</a>
        </div>
      ))}
    </div>
  )}
</AccountLayout>
