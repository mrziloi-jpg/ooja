---
import Layout from '~/layouts/Layout.astro';
import Login from '~/islands/Login';

// Only allow same-site relative redirects after login.
const raw = Astro.url.searchParams.get('next') ?? '/account';
const next = raw.startsWith('/') && !raw.startsWith('//') ? raw : '/account';
if (Astro.locals.user) return Astro.redirect(next);
const check = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex:0 0 auto;margin-top:4px"><path d="M20 6 9 17l-5-5"></path></svg>';
---
<Layout title="ورود یا ثبت‌نام" noindex active="account">
  <div class="wrap" style="padding-top:48px;padding-bottom:96px">
    <div style="display:flex;flex-wrap:wrap;border:1px solid #E5E5E3;max-width:1100px;margin:0 auto">
      <section style="flex:1 1 440px;min-width:0;padding:clamp(28px,5vw,64px)">
        <Login client:load next={next} />
      </section>
      <aside style="flex:1 1 380px;min-width:0;background:#111111;color:#FFFFFF;padding:clamp(28px,5vw,64px);display:flex;flex-direction:column;justify-content:space-between;gap:32px">
        <div style="display:flex;flex-direction:column;gap:14px">
          <p style="margin:0;font-size:12px;font-weight:600;color:#BDBDBD">باشگاه مشتریان LUMIÈRE</p>
          <p style="margin:0;font-size:clamp(24px,2.6vw,34px);font-weight:700;line-height:1.5">با یک حساب، روتینتان همیشه همراهتان است.</p>
        </div>
        <ul class="perks-dark">
          {['پیگیری سفارش‌ها و خرید دوباره با یک کلیک', 'ذخیره‌ی روتین پیشنهادی و علاقه‌مندی‌ها', 'امتیاز با هر خرید و هدیه‌ی تولد', 'یادآوری تمام شدن محصول'].map((t) => <li><Fragment set:html={check} />{t}</li>)}
        </ul>
      </aside>
    </div>
  </div>
</Layout>

<style>
  .perks-dark { list-style: none; margin: 0; padding: 0; }
  .perks-dark li { display: flex; gap: 12px; padding: 14px 0; border-top: 1px solid #333333; font-size: 14px; line-height: 1.8; }
  .perks-dark li:last-child { border-bottom: 1px solid #333333; }
</style>
