---
import Layout from '~/layouts/Layout.astro';
import Compat from '~/islands/Compat';
import { getCatalog } from '~/lib/catalog';
import { FUNCTIONS, functionLabel } from '~/lib/ingredients';
import { fa } from '~/lib/format';
import { config } from '~/lib/config';

const cat = await getCatalog();
const list = cat.ingredients;
const site = config.siteUrl.replace(/\/$/, '');
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'DefinedTermSet', name: 'واژه‌نامه‌ی ترکیبات مراقبت پوست LUMIÈRE', url: `${site}/ingredients`, inLanguage: 'fa-IR',
    hasDefinedTerm: list.map((g) => ({ '@type': 'DefinedTerm', name: g.nameFa, alternateName: g.nameEn, description: g.does, url: `${site}/ingredients/${g.slug}` })),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'خانه', item: site + '/' },
      { '@type': 'ListItem', position: 2, name: 'واژه‌نامه‌ی ترکیبات', item: `${site}/ingredients` },
    ],
  },
];
---
<Layout title="واژه‌نامه‌ی ترکیبات مراقبت پوست — کارکرد، غلظت و سازگاری" description="نیاسینامید، رتینال، ویتامین C، هیالورونیک اسید و سرامید چه می‌کنند؟ کارکرد، زمان مصرف، غلظت مناسب و جدول سازگاری ترکیبات مراقبت پوست." active="ingredients" jsonLd={jsonLd} cache={300}>
  <section style="background:#F4F4F2">
    <div class="wrap" style="padding-top:64px;padding-bottom:56px;display:flex;flex-wrap:wrap;gap:32px;align-items:flex-end;justify-content:space-between">
      <div style="flex:1 1 480px;display:flex;flex-direction:column;gap:14px">
        <p class="kicker" style="font-size:13px">واژه‌نامه‌ی ترکیبات</p>
        <h1 style="margin:0;font-size:clamp(34px,4.4vw,58px);font-weight:800;line-height:1.25;letter-spacing:-.02em">بدانید روی پوستتان<br />چه می‌زنید.</h1>
        <p style="margin:0;max-width:520px;font-size:16px;line-height:2;color:#3A3A3A">هر ترکیبی که در محصولات ما به کار می‌رود، با کارکرد، غلظت و سازگاری‌اش با ترکیبات دیگر.</p>
      </div>
      <div style="flex:0 1 440px;min-width:260px">
        <label for="iq" style="display:block;font-size:13px;font-weight:600;margin-bottom:8px">جستجوی ترکیب</label>
        <input id="iq" class="input" type="search" placeholder="مثلاً رتینال یا Niacinamide" autocomplete="off" />
      </div>
    </div>
  </section>

  <section class="wrap" style="padding-top:40px;padding-bottom:64px">
    <div role="group" aria-label="فیلتر بر اساس کارکرد" class="scroll-x" style="display:flex;gap:8px;padding-bottom:6px;margin-bottom:24px">
      <button type="button" class="chip" aria-pressed="true" data-func="all">همه</button>
      {FUNCTIONS.map(([k, l]) => <button type="button" class="chip" aria-pressed="false" data-func={k}>{l}</button>)}
    </div>
    <p data-empty hidden style="margin:0;padding:40px;background:#F4F4F2;text-align:center;font-size:15px">ترکیبی با این مشخصات پیدا نشد.</p>
    <ul class="ing-grid">
      {list.map((g, i) => (
        <li data-funcs={g.functions.join(' ')} data-search={`${g.nameEn} ${g.nameFa}`.toLowerCase()}>
          <a class="ing" href={`/ingredients/${g.slug}`}>
            <span class="sym" aria-hidden="true"><span style="font-size:9px;font-weight:600">{String(i + 1).padStart(2, '0')}</span><span class="en" style="font-size:22px;font-weight:700;line-height:.9">{g.sym ?? g.nameEn.slice(0, 2)}</span></span>
            <span class="en r" style="font-size:16px;font-weight:700">{g.nameEn}</span>
            <span style="font-size:14px;font-weight:500">{g.nameFa}</span>
            <span class="sub" style="font-size:12px">{functionLabel(g.functions)}{g.pct && ` · ${g.pct}`}</span>
            <span class="sub" style="font-size:13px;line-height:1.8">{g.does}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section style="border-top:1px solid #111111">
    <div class="wrap" style="padding-top:64px;padding-bottom:88px;display:flex;flex-direction:column;gap:28px">
      <div style="display:flex;flex-direction:column;gap:8px">
        <p class="kicker" style="font-size:13px">بررسی سازگاری</p>
        <h2 class="h2">می‌توانم این دو را با هم استفاده کنم؟</h2>
      </div>
      <Compat client:visible ingredients={list.map((g) => ({ slug: g.slug, nameEn: g.nameEn, nameFa: g.nameFa }))} />
      <p style="margin:0;font-size:13px;color:#5C5C5C">این راهنما کلی است. اگر پوست حساس دارید یا تحت درمان هستید، <a href="/consultation" style="text-decoration:underline">با کارشناس ما مشورت کنید</a>.</p>
    </div>
  </section>
</Layout>

<style>
  .ing-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); border-bottom: 1px solid #E5E5E3; border-inline-end: 1px solid #E5E5E3; }
  .ing { height: 100%; border-top: 1px solid #E5E5E3; border-inline-start: 1px solid #E5E5E3; background: #FFFFFF; padding: 22px; display: flex; flex-direction: column; gap: 10px; min-height: 170px; color: #111111; transition: background .2s; text-decoration: none; }
  .ing:hover { background: #F6F6F4; text-decoration: none; }
  .ing .sub { color: #5C5C5C; }
</style>

<script>
  const items = [...document.querySelectorAll<HTMLElement>('[data-funcs]')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-func]')];
  const input = document.getElementById('iq') as HTMLInputElement;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  let func = 'all';
  const norm = (t: string) => t.toLowerCase().replace(/ي/g, 'ی').replace(/ك/g, 'ک').trim();
  const apply = () => {
    const q = norm(input.value);
    let shown = 0;
    for (const el of items) {
      const ok = (func === 'all' || el.dataset.funcs!.split(' ').includes(func)) && (!q || norm(el.dataset.search!).includes(q));
      el.hidden = !ok;
      if (ok) shown++;
    }
    empty.hidden = shown > 0;
  };
  chips.forEach((c) => c.addEventListener('click', () => {
    func = c.dataset.func!;
    chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
    apply();
  }));
  input.addEventListener('input', apply);
</script>
