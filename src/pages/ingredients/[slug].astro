---
import Layout from '~/layouts/Layout.astro';
import ProductCard from '~/components/ProductCard.astro';
import Compat from '~/islands/Compat';
import { getCatalog } from '~/lib/catalog';
import { functionLabel, rel, VERDICT } from '~/lib/ingredients';
import { config } from '~/lib/config';

const cat = await getCatalog();
const g = cat.ingredients.find((x) => x.slug === Astro.params.slug);
if (!g) return new Response(null, { status: 404 });

const products = cat.products.filter((p) => p.ingredients.includes(g.slug));
const others = cat.ingredients.filter((x) => x.slug !== g.slug);
const cautions = others.map((x) => ({ x, r: rel(g.slug, x.slug) })).filter((c) => c.r === 'alt' || c.r === 'no');
const pairs = others.filter((x) => rel(g.slug, x.slug) === 'ok' && cat.products.some((p) => p.ingredients.includes(x.slug))).slice(0, 6);
const paragraphs = (g.body ?? '').split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const short = g.nameFa.replace(/\s*\(.*\)\s*/, '');

// Questions people search for, answered from the glossary fields (only when the field exists).
const faqs = [
  { q: `${short} چیست و چه کاری انجام می‌دهد؟`, a: g.does },
  g.goodFor && { q: `${short} برای چه نوع پوستی مناسب است؟`, a: `${g.goodFor}.` },
  g.whenToUse && { q: `${short} را صبح استفاده کنم یا شب؟`, a: `${g.whenToUse}.` },
  cautions.length && { q: `${short} را با چه ترکیباتی استفاده نکنم؟`, a: cautions.map((c) => `${c.x.nameFa}: ${VERDICT[c.r].title}`).join('؛ ') + '.' },
  g.pregnancy && { q: `آیا ${short} در بارداری بی‌خطر است؟`, a: `${g.pregnancy.replace('*', '')}. در دوران بارداری و شیردهی، پیش از استفاده از هر محصول جدید با پزشک خود مشورت کنید.` },
].filter(Boolean) as { q: string; a: string }[];

const site = config.siteUrl.replace(/\/$/, '');
const url = `${site}/ingredients/${g.slug}`;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'DefinedTerm', name: g.nameFa, alternateName: g.nameEn, description: g.does, url, inDefinedTermSet: `${site}/ingredients` },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'خانه', item: site + '/' },
      { '@type': 'ListItem', position: 2, name: 'واژه‌نامه‌ی ترکیبات', item: `${site}/ingredients` },
      { '@type': 'ListItem', position: 3, name: g.nameFa, item: url },
    ],
  },
];
---
<Layout title={`${short} چیست؟ خواص، نحوه‌ی مصرف و سازگاری ${g.nameEn}`} description={`${short} (${g.nameEn}): ${g.does}`.slice(0, 160)} active="ingredients" jsonLd={jsonLd} ogType="article" cache={300}>
  <div class="wrap" style="padding-top:20px">
    <nav aria-label="مسیر" style="font-size:13px;color:#5C5C5C;display:flex;flex-wrap:wrap;gap:8px">
      <a href="/" style="color:#5C5C5C">خانه</a><span aria-hidden="true">/</span>
      <a href="/ingredients" style="color:#5C5C5C">واژه‌نامه‌ی ترکیبات</a><span aria-hidden="true">/</span>
      <span style="color:#111111">{short}</span>
    </nav>
  </div>

  <article>
    <header class="wrap" style="padding-top:32px;padding-bottom:40px;display:flex;flex-wrap:wrap;gap:40px;align-items:flex-start">
      <div style="flex:2 1 480px;display:flex;flex-direction:column;gap:16px">
        <div style="display:flex;align-items:center;gap:16px">
          <span class="sym" aria-hidden="true" style="width:72px;height:72px"><span style="font-size:10px;font-weight:600">{g.pct ?? ''}</span><span class="en" style="font-size:30px;font-weight:700;line-height:.9">{g.sym ?? g.nameEn.slice(0, 2)}</span></span>
          <p class="kicker" style="font-size:13px">{functionLabel(g.functions)}</p>
        </div>
        <h1 style="margin:0;font-size:clamp(32px,4vw,52px);font-weight:800;line-height:1.3">{g.nameFa}</h1>
        <p class="en r" style="margin:0;font-size:20px;font-weight:600;color:#3A3A3A">{g.nameEn}</p>
        <p style="margin:0;max-width:640px;font-size:17px;line-height:2;color:#3A3A3A">{g.does}</p>
      </div>
      <div class="facts">
      <dl>
        <div><dt>مناسب برای</dt><dd>{g.goodFor ?? '—'}</dd></div>
        <div><dt>زمان مصرف</dt><dd>{g.whenToUse ?? '—'}</dd></div>
        <div><dt>غلظت در محصولات ما</dt><dd>{g.pct ?? '—'}</dd></div>
        <div><dt>بارداری</dt><dd>{g.pregnancy ?? '—'}</dd></div>
      </dl>
      <p style="margin:0;padding-top:10px;font-size:12px;color:#5C5C5C">* در دوران بارداری و شیردهی، پیش از استفاده از هر محصول جدید با پزشک خود مشورت کنید.</p>
      </div>
    </header>

    {paragraphs.length > 0 && (
      <section class="wrap" style="padding-bottom:48px">
        <div style="max-width:760px;display:flex;flex-direction:column;gap:16px;font-size:16px;line-height:2.1;color:#2A2A2A">
          {paragraphs.map((p) => <p style="margin:0">{p}</p>)}
        </div>
      </section>
    )}

    {products.length > 0 && (
      <section style="background:#F4F4F2">
        <div class="wrap" style="padding-top:56px;padding-bottom:56px">
          <h2 class="h2" style="margin-bottom:24px">محصولات حاوی {short}</h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:16px">
            {products.map((p) => <ProductCard p={p} height={280} />)}
          </div>
        </div>
      </section>
    )}

    <section class="wrap" style="padding-top:56px;padding-bottom:56px;display:flex;flex-direction:column;gap:24px">
      <h2 class="h2">ترکیب {short} با سایر ترکیبات</h2>
      {cautions.length > 0 && (
        <ul style="list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px">
          {cautions.map(({ x, r }) => (
            <li style="border:1px solid #111111;padding:18px;display:flex;gap:12px;align-items:flex-start">
              <span class={`dot ${r}`} aria-hidden="true" style="margin-top:4px"></span>
              <span style="display:flex;flex-direction:column;gap:4px"><a href={`/ingredients/${x.slug}`} style="font-weight:700">{x.nameFa}</a><span style="font-size:14px;line-height:1.8;color:#3A3A3A"><strong>{VERDICT[r].title}:</strong> {VERDICT[r].text}</span></span>
            </li>
          ))}
        </ul>
      )}
      {pairs.length > 0 && (
        <p style="margin:0;font-size:15px;line-height:2">به‌خوبی ترکیب می‌شود با: {pairs.map((x, i) => <>{i > 0 && '، '}<a href={`/ingredients/${x.slug}`} style="text-decoration:underline">{x.nameFa.replace(/\s*\(.*\)\s*/, '')}</a></>)}</p>
      )}
      <Compat client:visible showMatrix={false} initialA={g.slug} initialB={cautions[0]?.x.slug ?? others[0]?.slug} ingredients={cat.ingredients.map((x) => ({ slug: x.slug, nameEn: x.nameEn, nameFa: x.nameFa }))} />
    </section>

    <section style="border-top:1px solid #E5E5E3">
      <div class="wrap" style="padding-top:56px;padding-bottom:72px;max-width:900px;margin:0">
        <h2 class="h2" style="margin-bottom:16px">سؤالات متداول درباره‌ی {short}</h2>
        {faqs.map((f, i) => (
          <details class="faq" open={i === 0}>
            <summary>{f.q}</summary>
            <p style="margin:0 0 20px;font-size:15px;line-height:2;color:#3A3A3A">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section style="background:#111111;color:#FFFFFF">
      <div class="wrap" style="padding-top:48px;padding-bottom:48px;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:20px">
        <div style="display:flex;flex-direction:column;gap:6px">
          <p style="margin:0;font-size:22px;font-weight:700">نمی‌دانید {short} برای پوست شما مناسب است؟</p>
          <p style="margin:0;font-size:14px;color:#CFCFCF">تست ۶۰ ثانیه‌ای پوست، روتین مناسب شما را پیشنهاد می‌دهد.</p>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:10px">
          <a class="btn btn-white" href="/quiz">شروع تست پوست</a>
          <a class="btn" style="border:1px solid #FFFFFF;color:#FFFFFF" href="/ingredients">همه‌ی ترکیبات</a>
        </div>
      </div>
    </section>
  </article>
</Layout>

<style>
  .facts { flex: 1 1 320px; max-width: 460px; border: 1px solid #111111; padding: 8px 24px 20px; }
  .facts dl { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 20px; }
  .facts dl > div { padding: 14px 0; border-bottom: 1px solid #E5E5E3; }
  .facts dt { font-size: 12px; color: #5C5C5C; }
  .facts dd { margin: 4px 0 0; font-size: 15px; font-weight: 600; }
  .faq { border-top: 1px solid #E5E5E3; }
  .faq summary { min-height: 60px; display: flex; justify-content: space-between; align-items: center; gap: 16px; font-size: 16px; font-weight: 600; cursor: pointer; list-style: none; }
  .faq summary::after { content: '+'; font-size: 22px; font-weight: 300; }
  .faq[open] summary::after { content: '−'; }
  .faq summary::-webkit-details-marker { display: none; }
</style>
