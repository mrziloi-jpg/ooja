---
import Layout from '~/layouts/Layout.astro';
import Quiz from '~/islands/Quiz';
import { getCatalog } from '~/lib/catalog';
import { STEP_ROLE } from '~/lib/quiz';
import { config } from '~/lib/config';

// Only the products the quiz can recommend are sent to the browser.
const cat = await getCatalog();
const products = Object.fromEntries(Object.keys(STEP_ROLE).map((slug) => cat.bySlug.get(slug)).filter((p) => !!p).map((p) => {
  const v = p.variants.find((x) => x.stock > 0) ?? p.variants[0];
  return [p.slug, { slug: p.slug, variantId: v?.id ?? null, nameEn: p.nameEn, price: v?.price ?? 0, glass: p.glass, image: p.image, inStock: p.inStock }];
}));
const site = config.siteUrl.replace(/\/$/, '');
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'WebApplication', name: 'تست پوست LUMIÈRE', url: `${site}/quiz`,
  applicationCategory: 'HealthApplication', inLanguage: 'fa-IR', offers: { '@type': 'Offer', price: 0, priceCurrency: 'IRR' },
};
---
<Layout title="تست پوست آنلاین رایگان — روتین مخصوص پوست شما" description="تست پوست ۶۰ ثانیه‌ای: نوع پوست، نگرانی‌ها و آب‌وهوای محل زندگی‌تان را بگویید و روتین صبح و شب با ترتیب درست لایه‌گذاری بگیرید. رایگان." active="quiz" jsonLd={jsonLd} cache={300}>
  <div style="padding-bottom:96px">
    <Quiz client:load products={products} />
  </div>
</Layout>

<style is:global>
  .ans { width: 100%; min-height: 64px; padding: 14px 18px; border: 1px solid #D6D6D4; background: #FFFFFF; display: flex; align-items: center; gap: 16px; text-align: right; color: #111111; transition: border-color .2s; }
  .ans:hover { border-color: #111111; }
  .ans[aria-checked=true] { border-color: #111111; box-shadow: inset 0 0 0 1px #111111; }
  .mark { width: 22px; height: 22px; border: 1.5px solid #111111; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; }
  .mark.round { border-radius: 50%; }
  .mark.on { background: #111111; }
  .seg { min-height: 42px; padding: 0 18px; border: 1px solid #111111; background: #FFFFFF; font-size: 14px; color: #111111; }
  .seg[aria-checked=true] { background: #111111; color: #FFFFFF; }
  .qvial { width: 24px; height: 56px; border-radius: 3px 3px 8px 8px; border-top: 11px solid #111111; box-shadow: inset 0 0 0 1px rgba(0,0,0,.1); }
  .qthumb { background: radial-gradient(ellipse at 50% 40%, #FFFFFF 0%, #F4F4F2 80%); display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .qpop { animation: qpop .35s cubic-bezier(.2,.7,.2,1); }
  @keyframes qpop { from { opacity: 0; transform: translateX(-14px); } to { opacity: 1; transform: translateX(0); } }
  @media (prefers-reduced-motion: reduce) { .qpop { animation: none; } }
</style>
