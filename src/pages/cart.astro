---
import Layout from '~/layouts/Layout.astro';
import CartPage from '~/islands/CartPage';
import { getCartId, readCart } from '~/lib/cart';
import { getCatalog } from '~/lib/catalog';
import { getStore } from '~/lib/settings';
import { fa } from '~/lib/format';

const cart = await readCart(getCartId(Astro.cookies));
const cat = await getCatalog();
const store = await getStore();
const samples = cat.products.filter((p) => p.category === 'serums').map((p) => ({ slug: p.slug, nameEn: p.nameEn, glass: p.glass }));
---
<Layout title="سبد خرید" noindex>
  <div class="wrap" style="padding-top:28px;padding-bottom:96px">
    <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:24px">
      <h1 style="margin:0;font-size:clamp(30px,3.4vw,44px);font-weight:800">سبد خرید <span style="font-weight:400;color:#5C5C5C;font-size:.6em">({fa(cart.count)} کالا)</span></h1>
      <a href="/shop" style="font-size:14px;font-weight:600;text-decoration:underline;text-underline-offset:5px">ادامه‌ی خرید</a>
    </div>
    <CartPage client:load initial={cart} samples={samples} freeShipFrom={store.freeShipFrom} />
  </div>
</Layout>

<style is:global>
  .sample { min-height: 120px; padding: 14px 10px; border: 1px solid #D6D6D4; background: #FFFFFF; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; font-size: 12px; text-align: center; }
  .sample[aria-pressed=true] { border-color: #111111; box-shadow: inset 0 0 0 1px #111111; }
  .sample[disabled] { opacity: .45; cursor: not-allowed; }
</style>
