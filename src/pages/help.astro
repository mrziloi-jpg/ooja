---
import Layout from '~/layouts/Layout.astro';
import { and, asc, eq } from 'drizzle-orm';
import { db, schema as s } from '~/db';
import { CUSTOMER_STATUS, trackingSteps } from '~/lib/account';
import { str } from '~/lib/admin';
import { config, STORE } from '~/lib/config';
import { fa, money, normalizePhone, toEn } from '~/lib/format';
import { clientIp } from '~/lib/http';
import { rateLimit } from '~/lib/ratelimit';
import { getSettings, getStore } from '~/lib/settings';

const [store, st] = await Promise.all([getStore(), getSettings()]);
const u = Astro.locals.user;
const free = money(store.freeShipFrom);
const ship = Object.fromEntries(store.shipping.map((x) => [x.id, x]));
const minShip = Math.min(...store.shipping.map((x) => x.price));
const days = fa(STORE.returnDays);

const CATS = [['ship', 'ارسال'], ['return', 'مرجوعی'], ['pay', 'پرداخت و تخفیف'], ['account', 'حساب کاربری'], ['product', 'محصولات']] as const;
// Numbers come from the live settings so answers never contradict checkout.
const FAQ: [string, string, string][] = [
  ['ship', 'سفارشم چه زمانی می‌رسد؟', `سفارش‌ها تا ۲۴ ساعت کاری آماده می‌شوند. ${ship.post.name} ${ship.post.eta.split(' · ')[0]}، ${ship.tipax.name} ${ship.tipax.eta.split(' · ')[0]} و ${ship.courier.name} ${ship.courier.eta}.`],
  ['ship', 'هزینه‌ی ارسال چقدر است؟', `برای خریدهای بالای ${free} رایگان است. در غیر این صورت از ${money(minShip)} شروع می‌شود.`],
  ['ship', 'چطور سفارشم را پیگیری کنم؟', 'با شماره‌ی سفارش (در پیامک تأیید) و شماره‌ی موبایل، از فرم «پیگیری سفارش» همین صفحه؛ یا با ورود به حساب کاربری، بخش «سفارش‌ها». کد رهگیری پست هم پس از ارسال پیامک می‌شود.'],
  ['return', 'چطور کالا را مرجوع کنم؟', 'از بخش «سفارش‌ها» در حساب کاربری، گزینه‌ی «درخواست مرجوعی» را بزنید. کارشناس ما ظرف ۲۴ ساعت کاری تماس می‌گیرد. اگر مهمان خرید کرده‌اید، با همان شماره‌ی موبایل وارد شوید.'],
  ['return', 'اگر به محصول حساسیت داشتم چه کنم؟', `مصرف را متوقف کنید. حتی اگر محصول باز شده باشد، تا ${days} روز پس از تحویل می‌توانید آن را مرجوع کنید.`],
  ['pay', 'چه روش‌های پرداختی دارید؟', store.payments.map((p) => p.name).join('، ') + '.'],
  ['pay', 'کد تخفیفم کار نمی‌کند.', 'تاریخ اعتبار و حداقل مبلغ خرید را بررسی کنید. هر سفارش فقط یک کد تخفیف می‌پذیرد.'],
  ['pay', 'امتیاز باشگاه را چطور استفاده کنم؟', `هر ۱۰٬۰۰۰ تومان خرید ۱ امتیاز دارد. در حساب کاربری، بخش «امتیازها»، هر ${fa(STORE.redeemPoints)} امتیاز را به ${money(STORE.redeemCredit)} اعتبار خرید تبدیل کنید و هنگام پرداخت از آن استفاده کنید.`],
  ['account', 'رمز عبور ندارم؛ چطور وارد شوم؟', 'ورود فقط با شماره‌ی موبایل و کد یک‌بارمصرف پیامکی انجام می‌شود؛ نیازی به رمز عبور نیست.'],
  ['account', 'چطور شماره‌ی موبایلم را تغییر دهم؟', 'با پشتیبانی تماس بگیرید تا پس از تأیید هویت، شماره‌ی جدید را ثبت کنیم.'],
  ['account', 'چطور پیامک‌های تبلیغاتی را لغو کنم؟', 'در حساب کاربری، بخش «اطلاعات حساب»، گزینه‌ی پیامک تخفیف‌ها را خاموش کنید یا به پیامک‌ها «لغو۱۱» پاسخ دهید. پیامک وضعیت سفارش همچنان ارسال می‌شود.'],
  ['product', 'محصولات شما اصل هستند؟', 'همه‌ی محصولات مستقیماً از OOJA SHOP عرضه می‌شوند. کد ثبت سازمان غذا و دارو (IRC) هر محصول در صفحه‌ی همان محصول درج شده است.'],
  ['product', 'تاریخ انقضای محصولات چقدر است؟', 'تاریخ تولید و انقضا روی جعبه درج شده است. پس از باز کردن، مدت مصرف با نماد PAO (مثلاً 12M) روی بسته مشخص شده است.'],
  ['product', 'کدام محصول برای پوست من مناسب است؟', 'تست ۶۰ ثانیه‌ای پوست روتین مناسب شما را پیشنهاد می‌دهد. برای سؤال‌های دقیق‌تر، مشاوره‌ی رایگان ۱۵ دقیقه‌ای رزرو کنید.'],
];
const TOPICS = ['سفارش و ارسال', 'مرجوعی', 'سؤال درباره‌ی محصول', 'همکاری و عمده‌فروشی', 'سایر'];

// --- POST: order tracking (no login) or contact form ---
type Tracked = { o: typeof s.orders.$inferSelect; steps: ReturnType<typeof trackingSteps> } | null;
let tracked: Tracked = null;
let trackErr: string | null = null;
let contactErr: string | null = null;
let posted: FormData | null = null;
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  posted = f;
  const ip = clientIp(Astro as any);
  if (f.get('action') === 'track') {
    const code = toEn(str(f.get('order'))).toUpperCase().replace(/\s+/g, '');
    const phone = normalizePhone(str(f.get('phone')));
    if (!code || !phone) trackErr = 'شماره‌ی سفارش و شماره‌ی موبایل را کامل وارد کنید.';
    else if (!(await rateLimit(`track:${ip}`, 20, 600))) trackErr = 'تعداد تلاش‌ها بیش از حد مجاز است. چند دقیقه‌ی دیگر دوباره تلاش کنید.';
    else {
      // Both must match, so order numbers alone can't be used to look up someone else's order.
      const [o] = await db.select().from(s.orders).where(and(eq(s.orders.code, code), eq(s.orders.phone, phone))).limit(1);
      if (!o) trackErr = 'سفارشی با این مشخصات پیدا نشد. شماره‌ی سفارش و موبایل را بررسی کنید.';
      else {
        const events = await db.select().from(s.orderEvents).where(eq(s.orderEvents.orderId, o.id)).orderBy(asc(s.orderEvents.createdAt));
        tracked = { o, steps: trackingSteps(o, events) };
      }
    }
  } else if (f.get('action') === 'contact') {
    const name = str(f.get('name')).slice(0, 80);
    const phone = normalizePhone(str(f.get('phone')));
    const topic = TOPICS.includes(str(f.get('topic'))) ? str(f.get('topic')) : 'سایر';
    const body = str(f.get('message')).slice(0, 3000);
    if (name.length < 2 || !phone || body.length < 5) contactErr = 'نام، شماره‌ی موبایل معتبر و متن پیام لازم است.';
    else if (!(await rateLimit(`contact:${ip}`, 5, 3600))) contactErr = 'تعداد پیام‌ها بیش از حد مجاز است. لطفاً بعداً تلاش کنید.';
    else {
      const [m] = await db.insert(s.supportMessages).values({ userId: u?.id, name, phone, topic, body }).returning({ id: s.supportMessages.id });
      return Astro.redirect(`/help?sent=TK-${String(m.id).padStart(5, '0')}#contact`, 303);
    }
  }
}
const sent = Astro.url.searchParams.get('sent');
const val = (k: string, fallback = '') => (posted?.has(k) ? String(posted.get(k)) : fallback);
const site = config.siteUrl.replace(/\/$/, '');
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: FAQ.map(([, q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
  {
    '@context': 'https://schema.org', '@type': 'Organization', name: 'OOJA SHOP', url: site,
    contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', availableLanguage: 'fa', ...(store.supportPhone ? { telephone: store.supportPhone } : {}), ...(st.supportEmail ? { email: st.supportEmail } : {}) },
  },
];
// Public, unchanging GETs are cached; tracking results and confirmations are personal.
const cacheable = Astro.request.method === 'GET' && !Astro.url.search;
---
<Layout title="مرکز پشتیبانی — پیگیری سفارش، ارسال و مرجوعی" description={`پاسخ سؤالات متداول درباره‌ی ارسال، مرجوعی، پرداخت و حساب کاربری OOJA SHOP. پیگیری سفارش بدون ورود و تماس با پشتیبانی.`} active="help" jsonLd={jsonLd} cache={cacheable ? 300 : undefined} noindex={!cacheable}>
  <section style="background:#F4F4F2">
    <div class="wrap" style="padding-top:64px;padding-bottom:56px;display:flex;flex-direction:column;gap:18px;align-items:flex-start">
      <p class="kicker" style="font-size:13px">مرکز پشتیبانی</p>
      <h1 style="margin:0;font-size:clamp(34px,4.4vw,56px);font-weight:800;line-height:1.25">چطور می‌توانیم کمک کنیم؟</h1>
      <div style="width:100%;max-width:640px;position:relative">
        <label for="hq" class="sr-only">جستجو در سؤالات</label>
        <input id="hq" class="input" type="search" placeholder="مثلاً: مرجوعی، زمان ارسال، کد تخفیف…" autocomplete="off" style="min-height:56px;border-color:#111111;padding-inline-start:46px" />
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" style="position:absolute;top:19px;right:16px"><circle cx="11" cy="11" r="7.5"></circle><path d="m20.5 20.5-4-4"></path></svg>
      </div>
    </div>
  </section>

  <section class="wrap" style="padding-top:40px;padding-bottom:24px">
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px">
      <a class="htile" href="#track"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"></path><circle cx="7" cy="18" r="2"></circle><circle cx="17" cy="18" r="2"></circle></svg><span style="font-size:16px;font-weight:700">پیگیری سفارش</span><span style="font-size:13px;color:#5C5C5C">با شماره‌ی سفارش</span></a>
      {CATS.map(([k, l]) => (
        <button type="button" class="htile" aria-pressed="false" data-cat={k}><span style="font-size:16px;font-weight:700">{l}</span><span style="font-size:13px;opacity:.75">{fa(FAQ.filter((f) => f[0] === k).length)} سؤال</span></button>
      ))}
    </div>
  </section>

  <section class="wrap" style="padding-top:32px;padding-bottom:64px;display:flex;flex-wrap:wrap;gap:48px;align-items:flex-start">
    <div id="faq" style="flex:999 1 560px;min-width:0;scroll-margin-top:90px">
      <div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:8px">
        <h2 class="h2" data-faq-title>همه‌ی سؤالات</h2>
        <span style="font-size:13px;color:#5C5C5C" data-faq-count>{fa(FAQ.length)} سؤال</span>
      </div>
      <p data-faq-empty hidden style="margin:16px 0 0;padding:24px;background:#F4F4F2;font-size:15px">پاسخی پیدا نشد. از فرم تماس پایین صفحه برای ما پیام بفرستید.</p>
      <div style="border-bottom:1px solid #E5E5E3">
        {FAQ.map(([cat, q, a], i) => (
          <details class="faq" data-faq={cat} open={i === 0}>
            <summary>{q}</summary>
            <p style="margin:0 0 20px;font-size:15px;line-height:2;color:#3A3A3A">{a}</p>
          </details>
        ))}
      </div>
    </div>

    <aside id="track" style="flex:1 1 360px;max-width:460px;display:flex;flex-direction:column;gap:16px;scroll-margin-top:90px">
      <form method="post" action="/help#track" style="border:1px solid #111111;padding:24px;display:flex;flex-direction:column;gap:14px">
        <input type="hidden" name="action" value="track" />
        <h2 style="margin:0;font-size:20px;font-weight:800">پیگیری سفارش</h2>
        <p style="margin:0;font-size:13px;color:#5C5C5C">بدون ورود به حساب. شماره‌ی سفارش در پیامک تأیید آمده است.</p>
        <label class="field">شماره‌ی سفارش<input class="input en" name="order" required placeholder="LM-123456" value={val('order')} style="text-align:left" /></label>
        <label class="field">شماره‌ی موبایل<input class="input en" type="tel" name="phone" inputmode="numeric" required placeholder="09121234567" value={val('phone', u?.phone ?? '')} style="text-align:left" /></label>
        {trackErr && <p role="alert" class="err-t" style="margin:0;font-size:13px">{trackErr}</p>}
        <button class="btn btn-dark">پیگیری</button>
        {tracked && (
          <div role="status" style="border-top:1px solid #E5E5E3;padding-top:14px;display:flex;flex-direction:column;gap:10px">
            <p style="margin:0;font-size:15px;font-weight:700">سفارش <span class="en">{tracked.o.code}</span> · {CUSTOMER_STATUS[tracked.o.status].label}</p>
            <ol style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column">
              {tracked.steps.map((x) => (
                <li style={`display:flex;gap:12px;align-items:center;padding:6px 0;font-size:13px;color:${x.reached ? '#111111' : '#9A9A98'}`}>
                  <span aria-hidden="true" style={`width:12px;height:12px;border:1.5px solid currentColor;background:${x.reached ? '#111111' : '#FFFFFF'};border-radius:50%`}></span>
                  <span style={`flex:1 1 auto;font-weight:${x.current ? 800 : 500}`}>{x.label}</span><span>{x.time}</span>
                </li>
              ))}
            </ol>
            {tracked.o.trackingCode && <p style="margin:0;font-size:12px;color:#5C5C5C">کد رهگیری: <span class="en">{tracked.o.trackingCode}</span></p>}
            <a href="/login?next=/account/orders" style="font-size:13px;text-decoration:underline">جزئیات کامل و فاکتور در حساب کاربری</a>
          </div>
        )}
      </form>
      {(store.supportPhone || st.supportTelegram || st.supportEmail) && (
        <div style="background:#F4F4F2;padding:24px;display:flex;flex-direction:column;gap:10px;font-size:14px">
          <p style="margin:0;font-size:16px;font-weight:800">تماس مستقیم</p>
          {store.supportPhone && <p style="margin:0">تلفن: <a class="en" href={`tel:${toEn(store.supportPhone).replace(/[^\d+]/g, '')}`} style="font-weight:600">{store.supportPhone}</a></p>}
          {st.supportTelegram && <p style="margin:0">تلگرام و واتس‌اپ پشتیبانی: <span class="en" style="font-weight:600">{st.supportTelegram}</span></p>}
          {st.supportEmail && <p style="margin:0">ایمیل: <a class="en" href={`mailto:${st.supportEmail}`} style="font-weight:600">{st.supportEmail}</a></p>}
          {st.supportHours && <p style="margin:0;color:#5C5C5C">{st.supportHours}</p>}
        </div>
      )}
    </aside>
  </section>

  <section id="shipping" style="border-top:1px solid #111111;scroll-margin-top:90px">
    <div class="wrap" style="padding-top:56px;padding-bottom:56px">
      <h2 class="h2" style="margin-bottom:20px">ارسال و مرجوعی، خلاصه</h2>
      <div style="overflow-x:auto;border:1px solid #E5E5E3">
        <table class="ship">
          <thead><tr><th scope="col">روش ارسال</th><th scope="col">زمان تحویل</th><th scope="col">هزینه</th><th scope="col">محدوده</th></tr></thead>
          <tbody>
            {store.shipping.map((x) => {
              const [eta, area] = x.eta.split(' · ');
              return <tr><td style="font-weight:600">{x.name}</td><td>{eta}</td><td>{money(x.price)}</td><td>{area ?? (x.tehranOnly ? 'تهران' : 'سراسر کشور')}</td></tr>;
            })}
          </tbody>
        </table>
      </div>
      <p style="margin:14px 0 0;font-size:14px;line-height:2;color:#3A3A3A">
        ارسال همه‌ی روش‌ها برای خریدهای بالای {free} رایگان است. کالای باز نشده تا {days} روز و در صورت حساسیت پوستی، کالای باز شده هم تا {days} روز قابل بازگشت است.
        <a href="/returns" style="text-decoration:underline">شرایط کامل مرجوعی</a>
      </p>
    </div>
  </section>

  <section id="contact" style="background:#F4F4F2;scroll-margin-top:90px">
    <div class="wrap" style="padding-top:56px;padding-bottom:72px;display:flex;flex-wrap:wrap;gap:40px">
      <div style="flex:1 1 320px;display:flex;flex-direction:column;gap:12px">
        <h2 class="h2">پاسخ را پیدا نکردید؟</h2>
        <p style="margin:0;font-size:15px;line-height:2;color:#3A3A3A">پیام بفرستید؛ پاسخ را به شماره‌ی موبایل شما پیامک می‌کنیم. برای سؤال‌های مربوط به روتین، <a href="/consultation" style="text-decoration:underline">مشاوره‌ی رایگان</a> سریع‌تر است.</p>
      </div>
      <div style="flex:2 1 520px;min-width:0">
        {sent ? (
          <div role="status" style="background:#FFFFFF;border:1px solid #111111;padding:24px;display:flex;flex-direction:column;gap:6px">
            <p style="margin:0;font-size:18px;font-weight:800">پیام شما رسید.</p>
            <p style="margin:0;font-size:14px;color:#3A3A3A">کد پیگیری: <span class="en">{sent.replace(/[^A-Z0-9-]/g, '')}</span> · پاسخ را پیامک می‌کنیم.</p>
          </div>
        ) : (
          <form method="post" action="/help#contact" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px">
            <input type="hidden" name="action" value="contact" />
            <label class="field">نام<input class="input" name="name" required minlength="2" value={val('name', [u?.firstName, u?.lastName].filter(Boolean).join(' '))} autocomplete="name" /></label>
            <label class="field">شماره‌ی موبایل<input class="input en" type="tel" name="phone" required inputmode="numeric" value={val('phone', u?.phone ?? '')} style="text-align:left" autocomplete="tel" /></label>
            <label class="field" style="grid-column:1 / -1">موضوع
              <select class="input" name="topic">{TOPICS.map((t) => <option selected={val('topic') === t}>{t}</option>)}</select>
            </label>
            <label class="field" style="grid-column:1 / -1">پیام<textarea class="input" name="message" rows="4" required minlength="5" maxlength="3000" style="min-height:120px">{val('message')}</textarea></label>
            {contactErr && <p role="alert" class="err-t" style="margin:0;grid-column:1 / -1;font-size:13px">{contactErr}</p>}
            <div style="grid-column:1 / -1"><button class="btn btn-dark">ارسال پیام</button></div>
          </form>
        )}
      </div>
    </div>
  </section>

  <section id="accessibility" class="wrap" style="padding-top:56px;padding-bottom:72px;scroll-margin-top:90px;max-width:900px;margin:0">
    <h2 class="h2" style="margin-bottom:12px">دسترس‌پذیری</h2>
    <p style="margin:0;font-size:15px;line-height:2;color:#3A3A3A">
      این سایت طوری ساخته شده که با صفحه‌کلید و صفحه‌خوان قابل استفاده باشد: همه‌ی دکمه‌ها و فرم‌ها برچسب دارند، تمرکز صفحه‌کلید قابل مشاهده است و تضاد رنگ متن‌ها کافی است. اگر در استفاده از بخشی از سایت مشکل داشتید، از فرم بالا به ما خبر دهید تا آن را برطرف کنیم.
    </p>
  </section>
</Layout>

<style>
  .htile { border: 1px solid #E5E5E3; background: #FFFFFF; padding: 20px; min-height: 120px; display: flex; flex-direction: column; justify-content: flex-end; gap: 6px; text-align: right; color: #111111; text-decoration: none; }
  .htile:hover { border-color: #111111; text-decoration: none; }
  .htile[aria-pressed=true] { background: #111111; color: #FFFFFF; border-color: #111111; }
  .htile[aria-pressed=true] span { color: #FFFFFF !important; }
  .faq { border-top: 1px solid #E5E5E3; }
  .faq summary { min-height: 62px; display: flex; justify-content: space-between; align-items: center; gap: 16px; font-size: 16px; font-weight: 600; cursor: pointer; list-style: none; }
  .faq summary::after { content: '+'; font-size: 22px; font-weight: 300; }
  .faq[open] summary::after { content: '−'; }
  .faq summary::-webkit-details-marker { display: none; }
  .ship { border-collapse: collapse; width: 100%; min-width: 640px; font-size: 14px; }
  .ship th { text-align: right; padding: 14px 16px; background: #F4F4F2; }
  .ship td { padding: 14px 16px; border-top: 1px solid #E5E5E3; }
  .ship th + th, .ship td + td { border-inline-start: 1px solid #E5E5E3; }
</style>

<script>
  const items = [...document.querySelectorAll<HTMLDetailsElement>('[data-faq]')];
  const tiles = [...document.querySelectorAll<HTMLButtonElement>('[data-cat]')];
  const input = document.getElementById('hq') as HTMLInputElement;
  const title = document.querySelector('[data-faq-title]')!;
  const count = document.querySelector('[data-faq-count]')!;
  const empty = document.querySelector<HTMLElement>('[data-faq-empty]')!;
  const fa = (n: number) => String(n).replace(/[0-9]/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[+d]);
  const norm = (t: string) => t.toLowerCase().replace(/ي/g, 'ی').replace(/ك/g, 'ک').replace(/‌/g, ' ').trim();
  let cat = 'all';
  const apply = () => {
    const q = norm(input.value);
    let n = 0;
    for (const d of items) {
      const ok = (cat === 'all' || d.dataset.faq === cat) && (!q || norm(d.textContent ?? '').includes(q));
      d.hidden = !ok;
      if (ok) n++;
    }
    const active = tiles.find((t) => t.dataset.cat === cat);
    title.textContent = q ? `نتایج برای «${input.value.trim()}»` : active ? active.querySelector('span')!.textContent! : 'همه‌ی سؤالات';
    count.textContent = `${fa(n)} سؤال`;
    empty.hidden = n > 0;
  };
  tiles.forEach((t) => t.addEventListener('click', () => {
    cat = cat === t.dataset.cat ? 'all' : t.dataset.cat!;
    tiles.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.cat === cat)));
    apply();
    document.getElementById('faq')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }));
  input.addEventListener('input', apply);
</script>
