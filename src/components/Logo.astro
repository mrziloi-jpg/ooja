---
// OOJA SHOP logo: the "d" mark plus the wordmark. Drawn in currentColor, so it follows the text color
// (black in the header, white in the dark admin sidebar). `size` is the mark height in px.
interface Props { size?: number; wordmark?: boolean; class?: string; style?: string }
const { size = 28, wordmark = true, class: cls, style } = Astro.props;
---
<span class:list={['logo', cls]} style={`--logo-h:${size}px;${style ?? ''}`}>
  <svg class="logo-mark" viewBox="0 0 330 410" aria-hidden="true" focusable="false">
    <g fill="currentColor">
      <path d="M255.1 120.8A157 157 0 1 0 310 194.6L297 213.9A136 146 0 1 1 256.9 141.7Z"></path>
      <path d="M297 38Q300 17 319 6L319 248L304 252L297 212Z"></path>
    </g>
  </svg>
  {wordmark && <span class="logo-word">OOJA SHOP</span>}
</span>

<style>
  /* Proportions taken from the master logo: cap height ≈ 26% of the mark, text sits a little above center. */
  .logo { display: inline-flex; align-items: center; gap: calc(var(--logo-h) * .22); direction: ltr; line-height: 1; white-space: nowrap }
  .logo-mark { height: var(--logo-h); width: auto; flex: none }
  .logo-word { font-family: 'Helvetica Neue', Arial, 'Inter', sans-serif; font-weight: 700; font-size: calc(var(--logo-h) * .37); letter-spacing: .04em; margin-bottom: calc(var(--logo-h) * .17) }
</style>
