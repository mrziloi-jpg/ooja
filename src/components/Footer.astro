---
import { fa } from '~/lib/format';
import { getSettings } from '~/lib/settings';
const st = await getSettings();
const year = new Intl.DateTimeFormat('en-u-ca-persian', { year: 'numeric', timeZone: 'Asia/Tehran' }).format(new Date()).replace(/\D/g, '');
---
<footer style="background:#FFFFFF;border-top:1px solid #111111">
  <div class="wrap" style="padding-top:64px;padding-bottom:32px">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:40px;padding-bottom:48px">
      <div style="display:flex;flex-direction:column;gap:16px">
        <p class="en r" style="margin:0;font-size:22px;font-weight:700">LUMIÈRE<span style="color:#9A9A98">.</span></p>
        <p style="margin:0;font-size:13px;line-height:2;color:#4A4A4A">فرمول‌های بالینی با صداقت. مراقبت پوست و آرایش پوست‌محور.</p>
        {(st.instagram || st.telegramChannel) && (
          <div style="display:flex;gap:8px">
            {st.instagram && (
              <a class="social" href={st.instagram} rel="noopener" target="_blank" aria-label="اینستاگرام">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><path d="M17.5 6.5h.01"></path></svg>
              </a>
            )}
            {st.telegramChannel && (
              <a class="social" href={st.telegramChannel} rel="noopener" target="_blank" aria-label="تلگرام">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z"></path><path d="M22 2 11 13"></path></svg>
              </a>
            )}
          </div>
        )}
      </div>
      <nav aria-label="شرکت" style="display:flex;flex-direction:column;gap:10px">
        <p style="margin:0 0 6px;font-size:14px;font-weight:700">شرکت</p>
        <a class="flink" href="/about">درباره‌ی ما</a>
        <a class="flink" href="/about#careers">فرصت‌های شغلی</a>
        <a class="flink" href="/help#contact">تماس با ما</a>
      </nav>
      <nav aria-label="تعهدات" style="display:flex;flex-direction:column;gap:10px">
        <p style="margin:0 0 6px;font-size:14px;font-weight:700">تعهدات</p>
        <a class="flink" href="/ingredients">شفافیت ترکیبات</a>
        <a class="flink" href="/about#cruelty-free">بدون آزمایش حیوانی</a>
        <a class="flink" href="/about#sustainability">پایداری</a>
      </nav>
      <nav aria-label="خدمات مشتریان" style="display:flex;flex-direction:column;gap:10px">
        <p style="margin:0 0 6px;font-size:14px;font-weight:700">خدمات مشتریان</p>
        <a class="flink" href="/help#shipping">ارسال و مرجوعی</a>
        <a class="flink" href="/help#track">پیگیری سفارش</a>
        <a class="flink" href="/help#faq">سؤالات متداول</a>
        <a class="flink" href="/returns">شرایط مرجوعی</a>
      </nav>
      <div style="display:flex;flex-direction:column;gap:10px">
        <p style="margin:0 0 6px;font-size:14px;font-weight:700">مجوزها</p>
        <div style="display:flex;gap:8px">
          <!-- Replace with the official eNamad and Samandehi embed snippets once issued. -->
          <div style="width:78px;height:88px;border:1px dashed #BDBDBD;display:flex;align-items:center;justify-content:center;text-align:center;font-size:11px;line-height:1.6;color:#5C5C5C;padding:6px">[نماد اعتماد]</div>
          <div style="width:78px;height:88px;border:1px dashed #BDBDBD;display:flex;align-items:center;justify-content:center;text-align:center;font-size:11px;line-height:1.6;color:#5C5C5C;padding:6px">[مجوز غذا و دارو]</div>
        </div>
      </div>
    </div>
    <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:16px;padding-top:24px;border-top:1px solid #E5E5E3;font-size:13px;color:#4A4A4A">
      <div style="display:flex;flex-wrap:wrap;align-items:center;gap:20px">
        <span style="display:inline-flex;align-items:center;gap:8px;border:1px solid #D6D6D4;padding:6px 12px">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"></path></svg>
          ایران · فارسی · تومان
        </span>
        <span>© {fa(year)} <span class="en">LUMIÈRE</span> — تمامی حقوق محفوظ است.</span>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:20px">
        <a class="flink" style="font-size:13px" href="/privacy">حریم خصوصی</a>
        <a class="flink" style="font-size:13px" href="/terms">قوانین و مقررات</a>
        <a class="flink" style="font-size:13px" href="/help#accessibility">دسترس‌پذیری</a>
      </div>
    </div>
  </div>
</footer>
