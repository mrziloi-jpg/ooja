---
import type { Product } from '~/lib/catalog';
import { BADGES, group, money } from '~/lib/format';
import ProductArt from './ProductArt.astro';
import Stars from './Stars.astro';

interface Props { p: Product; height?: number; eager?: boolean; headingLevel?: 'h2' | 'h3' }
const { p, height = 340, eager = false, headingLevel = 'h3' } = Astro.props;
const badge = p.badge ? BADGES[p.badge] : null;
const first = p.variants.find((v) => v.stock > 0) ?? p.variants[0];
const H = headingLevel;
---
<article class="pcard" data-product={p.id}>
  <div style="position:relative">
    <a href={`/p/${p.slug}`} tabindex="-1" aria-hidden="true" style="display:block">
      <div class="stage" style={`height:${height}px`}>
        {badge && <span class="badge" class:list={{ solid: badge[1] }}>{badge[0]}</span>}
        {!p.image && <div class="glow" aria-hidden="true"></div>}
        {!p.image && <div class="floor" aria-hidden="true"></div>}
        <ProductArt shape={p.shape} glass={p.glass} nameEn={p.nameEn} image={p.image} eager={eager} />
      </div>
    </a>
    <button class="icon-btn wish" type="button" data-wish={p.id} aria-pressed="false" aria-label={`افزودن ${p.nameFa} به علاقه‌مندی‌ها`}>
      <svg width="19" height="19" viewBox="0 0 24 24" class="heart" aria-hidden="true"><path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7Z"></path></svg>
    </button>
  </div>
  <div style="padding-top:16px;display:flex;flex-direction:column;gap:6px;flex:1 1 auto">
    <H class="en r" style="margin:0;font-size:16px;font-weight:600;line-height:1.35"><a href={`/p/${p.slug}`}>{p.nameEn}</a></H>
    <p style="margin:0;font-size:14px;font-weight:500;color:#333333">{p.nameFa}</p>
    {p.tagline && <p style="margin:0;font-size:13px;color:#5C5C5C">{p.tagline}</p>}
    {p.reviewsCount > 0 && (
      <div style="display:flex;align-items:center;gap:6px;padding-top:2px">
        <Stars value={p.rating} />
        <span style="font-size:12px;color:#5C5C5C">({group(p.reviewsCount)})</span>
      </div>
    )}
    {p.variants.length > 1 && (
      <div style="display:flex;flex-wrap:wrap;align-items:center;gap:6px;padding-top:8px" role="group" aria-label="انتخاب حجم">
        {p.variants.map((v) => (
          <button type="button" class="size" data-size={v.id} data-price={v.price} aria-pressed={v.id === first.id} disabled={v.stock <= 0}>{v.label}</button>
        ))}
      </div>
    )}
    <p style="margin:8px 0 10px;font-size:16px;font-weight:700" data-price-label>{money(first.price)}</p>
    {p.inStock ? (
      <button type="button" class="add" style="margin-top:auto" data-add={first.id} data-name={p.nameFa} aria-label={`افزودن ${p.nameFa} به سبد خرید`}>افزودن به سبد</button>
    ) : (
      <button type="button" class="add" style="margin-top:auto" disabled>ناموجود</button>
    )}
  </div>
</article>
