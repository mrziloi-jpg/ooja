proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_set_header Host $host;
proxy_set_header X-Forwarded-Host $host;
# $remote_addr is the visitor's IP here: the real_ip settings in nginx.conf take it from the edge's X-Real-IP.
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
# "https" from the edge proxy (see the $lumiere_proto map in nginx.conf).
proxy_set_header X-Forwarded-Proto $lumiere_proto;
proxy_read_timeout 30s;
